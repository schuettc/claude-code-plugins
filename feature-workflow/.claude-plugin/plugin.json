{
  "name": "feature-workflow",
  "version": "9.1.0",
  "description": "Feature lifecycle management with external review gates. Capture ideas (idea.md), plan (plan.md), review plans and implementations via draft PRs, and ship (shipped.md). Status determined by file presence with auto-generated DASHBOARD.md.",
  "author": {
    "name": "Court Schuett"
  },
  "skills": "./skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py",
            "timeout": 5,
            "statusMessage": "Checking feature file permissions..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py",
            "timeout": 5,
            "statusMessage": "Checking feature file permissions..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py",
            "timeout": 30,
            "statusMessage": "Updating feature dashboard..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post_tool_use.py",
            "timeout": 30,
            "statusMessage": "Updating feature dashboard..."
          }
        ]
      }
    ]
  }
}
